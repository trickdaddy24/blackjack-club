generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  password       String?
  role           String    @default("user")
  chips          Int       @default(10000)
  // Second, independent bankroll for the Trilux table (Room "trilux"). Funded
  // only by explicit transfers from `chips` — never seeded, so it starts at 0
  // and a player who never visits Trilux is unaffected. Every place that reads
  // chips as a MEASURE OF WEALTH (High Rollers, VIP tier) must sum both
  // columns via totalWorth() in lib/wallet.ts, or moving money between
  // wallets silently demotes the player.
  triluxChips    Int       @default(0)
  dealerTips     Int       @default(0)
  lastDailyBonus DateTime?
  // Consecutive winning rounds (pushes don't break the run) — settle-time
  // bookkeeping so streak achievements never need to scan history.
  winStreak      Int       @default(0)
  bestWinStreak  Int       @default(0)
  // Consecutive Vegas days with a claimed daily bonus — boosts the bonus.
  loginStreak    Int       @default(0)
  // Last Vegas day a property-pick bonus was claimed — independent of, and
  // stacks alongside, the flat daily bonus above.
  lastPropertyPick DateTime?
  // Highest VIP tier already credited (see lib/vip.ts) — lets the lazy
  // check in vip-io.ts pay the one-time tier-up bonus exactly once.
  vipTier          Int       @default(0)
  // Match-play voucher (lib/voucher.ts): non-null + in the future means an
  // active "double your next win" window is running. lastVoucherGrantedAt
  // persists past expiry/consumption — it's the one-per-Vegas-day guard.
  voucherExpiresAt    DateTime?
  lastVoucherGrantedAt DateTime?
  // Last Vegas day the chip wheel was spun — independent of, and stacks
  // alongside, the flat daily bonus and the property-pick bonus.
  lastChipWheelSpin DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  rounds              Round[]
  trainerStat         TrainerStat?
  proBookStat         ProBookStat?
  achievements        Achievement[]
  passwordResetTokens PasswordResetToken[]
  tournamentEntries   TournamentEntry[]
}

// Forgot-password flow. tokenHash is sha256 of the raw token mailed to the
// user — the raw value never touches the DB, mirroring how session/invite
// tokens are handled elsewhere. Single-use (usedAt) + 1h expiry.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Round {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String // "insurance" | "player" | "settled"
  bet       Int
  stateJson String
  netResult Int       @default(0)
  // Side-bet net for the round (PP/21+3/Lucky Ladies/bust bet stakes vs
  // payouts, plus any jackpot won) — netResult tracks the main game only.
  sideNet   Int       @default(0)
  // Shared-table round this row records (one row PER PLAYER at settle).
  // Null = solo. Solo shoe carry-over skips table rounds.
  tableId   String?
  // Tournament hand this row records (see TournamentEntry) — an isolated
  // stack, so its shoe carry-over is scoped to this entry, never the
  // player's solo shoe. Null = not a tournament hand.
  tournamentEntryId String?
  createdAt DateTime  @default(now())
  settledAt DateTime?
  // Which table this round was played at — "classic" (green/gold) or
  // "trilux" (blue, Match the Dealer + Trilux Bonus). Drives the leaderboard
  // filter; stateJson.room carries the same value for the engine's own use.
  room      String    @default("classic")

  @@index([userId, status])
  @@index([settledAt])
  @@index([tournamentEntryId])
  @@index([room, settledAt])
}

// A shared 2-player table (game-agnostic social layer — gameType decides the
// engine). Live round state rides in stateJson; per-player Round rows are
// written only at settle.
model Table {
  id            String    @id @default(cuid())
  gameType      String    @default("blackjack")
  status        String    @default("open") // "open" (no guest) | "active" | "ended"
  hostId        String
  guestId       String?
  stateJson     String? // current/last shared RoundState (carries the shoe)
  hostBet       Int       @default(0) // next-round wagers; 0 = not placed yet
  guestBet      Int       @default(0)
  hostSideJson  String? // {pp,tp,ll} for the next round
  guestSideJson String?
  // Player-phase turn clock; expired = the active hand auto-stands (enforced
  // lazily by whichever request arrives next)
  turnDeadline  DateTime?
  // Quick reactions, as a small capped ring buffer (see lib/emotes.ts). Rides
  // the existing table poll — no socket — and entries expire on read, so this
  // never needs a cleanup job.
  emotesJson    String?
  endedReason   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([hostId, status])
  @@index([guestId, status])
}

// Table invite: members-only, 5-minute expiry, superseded when the host
// invites someone else. Expiry/supersession are enforced lazily on read.
model Invite {
  id        String   @id @default(cuid())
  tableId   String
  fromId    String
  toId      String
  status    String   @default("pending") // pending|accepted|canceled|expired|superseded
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([toId, status])
  @@index([tableId, status])
}

// A shared 4-seat partnership Spades table (Duo social layer, v0.48.0) — a
// NEW model rather than extending Table, which is hard-wired to 2 seats plus
// blackjack money fields (hostBet/guestBet) and can't hold a 4-seat
// partnership. Seats 0 & 2 are the two human players (partners — the
// engine's teamOf(seat) = seat % 2 pairs 0&2 vs 1&3, mirrored here by
// hostId=seat0/guestId=seat2); seats 1 & 3 are always bots in v1 — no lobby,
// no variable headcount, so they need no DB columns at all. The full
// GameState (src/spades/engine/types.ts) rides in stateJson exactly like
// Table.stateJson, but — unlike Table — that raw JSON must NEVER be sent to
// a browser as-is: every read goes through spadesClientView() (in
// src/spades/engine/clientView.ts), which redacts every seat but the
// viewer's own down to a card count. turnDeadline reuses the existing 30s
// turn-clock convention from Table, enforced lazily by whichever request
// arrives next (see lib/spades-table.ts). NO betting/wager fields — v1
// deliberately has no buy-in and no way to split a partnership win/loss
// across a wager (unlike Table.hostBet/guestBet).
model SpadesTable {
  id           String    @id @default(cuid())
  status       String    @default("open") // "open" (no guest) | "active" | "ended"
  hostId       String // seat 0
  guestId      String? // seat 2 — null until the invite is accepted
  stateJson    String? // full GameState — NEVER sent to a client as-is, see above
  turnDeadline DateTime?
  endedReason  String? // e.g. "gameOver" once a team reaches the target score
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([hostId, status])
  @@index([guestId, status])
}

// Spades table invite: mirrors Invite's shape/lifecycle exactly (members
// only, 5-minute expiry, superseded when the host invites someone else,
// both enforced lazily on read) but points at a SpadesTable. The moment the
// invited friend accepts, the table auto-starts immediately (deals the
// first hand) — no separate "host clicks start" step, because headcount is
// always fixed at exactly 4 (2 human + 2 bot) the instant the second human
// seats.
model SpadesInvite {
  id            String   @id @default(cuid())
  spadesTableId String
  fromId        String
  toId          String
  status        String   @default("pending") // pending|accepted|canceled|expired|superseded
  createdAt     DateTime @default(now())
  expiresAt     DateTime

  @@index([toId, status])
  @@index([spadesTableId, status])
}

// Sit-and-go tournament (v0.47.0): an independent-stack leaderboard, NOT a
// head-to-head table — each entrant plays HANDS_PER_ENTRANT solo hands
// against the dealer with their own isolated stack, self-paced (no lockstep,
// no realtime sync across entrants needed). Buy-in is 1:1 off the player's
// main `chips` balance; the isolated stack lives only on TournamentEntry.
// The 24h completion deadline and the idle-lobby auto-cancel are both
// enforced lazily on read (same convention as Invite expiry above) — no
// cron job in this codebase.
model TournamentLobby {
  id          String    @id @default(cuid())
  creatorId   String
  status      String    @default("open") // "open" | "active" | "settled" | "canceled"
  buyIn       Int       @default(1000)
  prizePool   Int       @default(0) // sum of buy-ins actually collected (backed-out entrants are removed)
  // Idle-cancel clock: bumped on every join. No NEW joins for IDLE_CANCEL_MS
  // while still "open" ⇒ swept and fully refunded on the next read.
  lastJoinAt  DateTime  @default(now())
  startedAt   DateTime?
  // startedAt + COMPLETION_DEADLINE_MS — unfinished entrants are forfeited
  // in place (ranked by whatever stack they'd reached) once this passes.
  deadlineAt  DateTime?
  settledAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  entries     TournamentEntry[]

  @@index([status])
  @@index([status, lastJoinAt])
  @@index([status, deadlineAt])
}

model TournamentEntry {
  id          String    @id @default(cuid())
  lobbyId     String
  lobby       TournamentLobby @relation(fields: [lobbyId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Isolated tournament stack — starts at the lobby's buyIn, never touches
  // the player's main `chips` balance again until the prize settles.
  stack       Int
  handsPlayed Int       @default(0)
  // "joined" (pre-start) | "playing" | "finished" (hit HANDS_PER_ENTRANT or
  // busted below the minimum bet) | "forfeited" (deadline hit mid-run) |
  // "backed-out" (voluntary pre-start exit, refunded) | "refunded" (lobby
  // never reached the minimum, auto-canceled)
  status      String    @default("joined")
  // Stack snapshot at finish/forfeit — what ranking and payout are computed
  // from. Null until the entry reaches a terminal playing state.
  finalStack  Int?
  rank        Int?
  prize       Int       @default(0)
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([lobbyId, userId])
  @@index([lobbyId, status])
  @@index([userId])
}

// Server-side strategy-trainer record: blind decisions graded by the API
// against its own basic-strategy book. Feeds the Strategy Masters board.
model TrainerStat {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  right     Int      @default(0)
  wrong     Int      @default(0)
  streak    Int      @default(0)
  best      Int      @default(0)
  updatedAt DateTime @updatedAt
}

// Pro-book (Illustrious 18) strategy-trainer record (#9) — mirrors TrainerStat
// exactly, but grades blind decisions against the count-deviation book
// instead of basic strategy. Written IN ADDITION to TrainerStat (never
// instead of it) whenever a blind decision is made with pro-book toggled on
// on the classic table: Strategy Masters' basic-strategy grading must never
// shift under a player who opts into the pro book, so the two scorecards
// are kept fully independent. Personal-only for v1 — no leaderboard tab.
model ProBookStat {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  right     Int      @default(0)
  wrong     Int      @default(0)
  streak    Int      @default(0)
  best      Int      @default(0)
  updatedAt DateTime @updatedAt
}

// Site-wide progressive pots (Lucky Ladies). Seeded on first use; every
// Lucky Ladies stake feeds the pot; a hit pays the whole pot and reseeds.
model Jackpot {
  name      String   @id
  amount    Int
  updatedAt DateTime @updatedAt
}

// Pit-boss "force promo" override — a server-side flag with expiry, not a
// code change (docs/ADMIN-CONSOLE.md). Single global row (id "global").
// promoId null or expiresAt in the past = no override; PROMO_SCHEDULE runs
// normally. Every currentPromo() call site that gates real payouts checks
// this alongside the schedule.
model PromoOverride {
  id        String    @id
  promoId   String?
  expiresAt DateTime?
}

// Random surprise bonus dropped on a currently-active player, Vegas
// "hot seat" style. Single global row (id "global"); nextDropAt is a
// CAS mutex — whichever request's updateMany claims it runs the draw.
// last* fields are the most recent drop, broadcast to every client via
// /api/game/state so winners get a toast and everyone else gets the
// social-proof nudge.
model HotSeatDrop {
  id             String    @id
  nextDropAt     DateTime
  lastWinnerId   String?
  lastWinnerName String?
  lastAmount     Int?
  lastAwardedAt  DateTime?
}

// Audit trail for the pit-boss console — every mutating admin action writes
// a row. detail is JSON ({amount, reason, before, after, ...}).
model AdminAction {
  id        String   @id @default(cuid())
  adminId   String
  action    String // "chips-adjust" | "role-set" | "achievement-grant" | "achievement-revoke" | "purge"
  targetId  String?
  detail    String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Counting Gym drill: server-issued card sequence + truth; the row is the
// grade record. cardsJson ships to the client (it must render them) — the
// personal-stats tradeoff is accepted for Phase 1, like the trainer's
// blind attestation.
model GymDrill {
  id        String   @id @default(cuid())
  userId    String
  level     String
  speedMs   Int
  count     Int
  cardsJson String
  answer    Int // true Hi-Lo running count
  submitted Int?
  correct   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Daily-quest progress: one row per player per Vegas day per quest. The
// catalog and rotation live in code (src/lib/quests.ts); rewards are paid
// the moment `done` flips.
model QuestProgress {
  userId   String
  day      String // Vegas date key, "2026-07-16"
  slug     String
  progress Int     @default(0)
  done     Boolean @default(false)

  @@id([userId, day, slug])
  @@index([day])
}

// Board-champion payouts: one row per closed window per board (amount 0 =
// evaluated, nobody qualified). Awarded lazily by whoever views the boards
// first after the window closes.
model BoardAward {
  id          String   @id @default(cuid())
  board       String // "daily" | "weekly"
  windowStart DateTime
  userId      String?
  amount      Int
  createdAt   DateTime @default(now())

  @@unique([board, windowStart])
}

// One row per unlocked achievement. The catalog (names, conditions, art)
// lives in code (src/lib/achievements.ts) — the DB only records the unlock.
model Achievement {
  userId     String
  slug       String
  unlockedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, slug])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
